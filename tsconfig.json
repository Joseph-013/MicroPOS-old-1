{
  "compilerOptions": {
    "target": "ES6",
    "allowJs": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "sourceMap": true,
    "rootDir": "../",
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "paths": {
      "@config/*": ["./src/config/*"],
      "@db/*": ["./src/db/*"],
      "@server/*": ["./src/server/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["src/**/*", "drizzle.config.ts"],
  "exclude": ["dist", "node_modules", "angular"]
}
