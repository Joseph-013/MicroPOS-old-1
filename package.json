{
  "name": "micropos",
  "productName": "micropos",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "postinstall": "unzip -o ~/.cache/electron/0398eab6ff3b10eeeae02ced94c086c2894afe98d8b58a4a1f6e485064ac1f7f/electron-v42.3.3-linux-x64.zip -d node_modules/electron/dist/ && printf 'electron' > node_modules/electron/path.txt",
    "dev": "concurrently --kill-others \"npm run dev:angular:ui\" \"npm run dev:angular:client\" \"npm run dev:electron\"",
    "dev:angular:ui": "npm run serve:ui --prefix angular",
    "dev:angular:client": "npm run serve:client --prefix angular",
    "dev:electron": "wait-on http://localhost:4200 && electron-forge start -- --trace-warnings",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": {
    "name": "Joseph-013",
    "email": "josephvictorpaduga@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node-hid": "^1.3.4",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "concurrently": "^10.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.11.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.7.2",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.3",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@micropos/shared": "file:shared",
    "@point-of-sale/receipt-printer-encoder": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "canvas": "^3.2.3",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "node-hid": "^3.3.0",
    "rxjs": "^7.8.2",
    "selfsigned": "^5.5.0",
    "usb": "^3.0.0",
    "uuidv7": "^1.2.1"
  }
}
